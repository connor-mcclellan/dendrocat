include README.rst
include MANIFEST.in
include pyproject.toml
include setup.cfg
include setup.py

recursive-include dendrocat *.py *.c *.pyx *.pxd
recursive-include dendrocat/data *
recursive-include dendrocat/tests *.py

include dendrocat/tests/coveragerc

recursive-include docs *
recursive-exclude docs/_build *

include licenses/*.rst

global-exclude *.pyc *.o *.so
global-exclude __pycache__
